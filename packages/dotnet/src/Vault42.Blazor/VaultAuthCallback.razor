@using Microsoft.AspNetCore.Components
@inject VaultAuthService AuthService
@inject NavigationManager Navigation

@if (_processing)
{
    @if (Loading is not null)
    {
        @Loading
    }
    else
    {
        <p>Completing authentication...</p>
    }
}
else if (_error)
{
    @if (Error is not null)
    {
        @Error
    }
    else
    {
        <p>Authentication failed.</p>
    }
}

@code {
    /// <summary>
    /// URI to navigate to after successful authentication.
    /// Default: "/" (application root).
    /// </summary>
    [Parameter] public string RedirectTo { get; set; } = "/";

    /// <summary>
    /// Optional loading content to display while processing the callback.
    /// </summary>
    [Parameter] public RenderFragment? Loading { get; set; }

    /// <summary>
    /// Optional error content to display when authentication fails.
    /// </summary>
    [Parameter] public RenderFragment? Error { get; set; }

    /// <summary>
    /// Callback invoked when authentication succeeds.
    /// </summary>
    [Parameter] public EventCallback OnSuccess { get; set; }

    /// <summary>
    /// Callback invoked when authentication fails.
    /// </summary>
    [Parameter] public EventCallback<string> OnError { get; set; }

    private bool _processing = true;
    private bool _error;

    /// <summary>
    /// Completes the OAuth2 redirect: exchanges the authorization code, then either
    /// navigates to <see cref="RedirectTo"/> or renders the error state.
    /// </summary>
    /// <returns>A task that completes once the exchange has settled and the outcome has been raised.</returns>
    /// <remarks>
    /// Runs once, on first render. The component reads the callback URI from the
    /// <see cref="NavigationManager"/> itself, so it only works when routed to at the
    /// registered redirect URI. A failure raises <see cref="OnError"/> and stays put; it does not
    /// navigate, so the app can offer a retry.
    /// </remarks>
    protected override async Task OnInitializedAsync()
    {
        var currentUri = Navigation.Uri;
        var success = await AuthService.HandleCallbackAsync(currentUri);

        _processing = false;

        if (success)
        {
            if (OnSuccess.HasDelegate)
                await OnSuccess.InvokeAsync();

            Navigation.NavigateTo(RedirectTo);
        }
        else
        {
            _error = true;
            if (OnError.HasDelegate)
                await OnError.InvokeAsync("Authentication failed");
        }
    }
}
