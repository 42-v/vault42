.git/
.github/
.gitignore
.gitlab-ci.yml
.idea/
.vscode/

# Node artifacts (source dirs are needed for multi-stage frontend build)
node_modules/
web/node_modules/
packages/vue/node_modules/
packages/csharp/
web/dist/

# K8s / Docker
k8s/
charts/
docker-compose*.yml

# Tests (not needed in image)
tests/
coverage.out

# Docs
docs/
*.md
LICENSE
ROADMAP.md

# Secrets
secrets/
*.pem
*.key
# A .dockerignore pattern without a leading ** is anchored at the context root,
# so `.env` excluded /.env and nothing else: web/.env, which every developer who
# has run the dev stack has, was being copied into the release image. What kept a
# dev API origin out of a published bundle was the forbid-dev-origins Rollup
# plugin failing the build, which is a guard doing a job the context should never
# have handed it.
.env
.env.*
**/.env
**/.env.*

# Scripts
scripts/
