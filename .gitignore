# Secrets (never commit)
*.pem
*.key
secrets/
.env
.env.*
# ...except the web dashboard's dev-server origin, which holds no secret.
# Tracking it is what stops it being re-created as web/.env, which Vite
# loads in production builds too and which therefore ended up baked into
# the Go binary and all three images.
!web/.env.development

# Dev TLS certs (generated by deploy-dev.sh)
k8s/dev/

