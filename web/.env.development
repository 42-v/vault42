# Loaded by `vite dev` only.
#
# This used to be `web/.env`, which Vite loads in *every* mode. That put
# https://vault.localhost into web/dist, which scripts/build-all.sh copies into
# internal/frontend/dist and go:embed compiles into the binary and all three
# images. Naming it .env.development scopes it to the dev server; see
# web/src/config.ts for the second half of the fix and web/vite.config.ts for
# the build-time assertion that catches a regression.
VITE_VAULT_URL=https://vault.localhost
